{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "turn-coordination-experiment",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-11",
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION",
        "class_name": "SessionObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionObject"]
    }
  ]
}
